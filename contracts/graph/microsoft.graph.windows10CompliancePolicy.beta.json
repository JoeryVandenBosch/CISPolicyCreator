{
  "schemaVersion": "1.0",
  "id": "microsoft.graph.windows10CompliancePolicy.beta",
  "sourceUrl": "https://learn.microsoft.com/en-us/graph/api/resources/intune-deviceconfig-windows10compliancepolicy?view=graph-rest-beta",
  "lastReviewed": "2026-08-18",
  "endpoint": "https://graph.microsoft.com/beta/deviceManagement/deviceCompliancePolicies",
  "listEndpoint": "https://graph.microsoft.com/beta/deviceManagement/deviceCompliancePolicies?$select=id,displayName",
  "itemEndpointTemplate": "https://graph.microsoft.com/beta/deviceManagement/deviceCompliancePolicies/{id}",
  "nameProperty": "displayName",
  "odataType": "#microsoft.graph.windows10CompliancePolicy",
  "properties": {
    "@odata.type": {
      "type": "string",
      "required": true,
      "const": "#microsoft.graph.windows10CompliancePolicy"
    },
    "displayName": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "description": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "bitLockerEnabled": {
      "type": "boolean",
      "required": false
    },
    "secureBootEnabled": {
      "type": "boolean",
      "required": false
    },
    "codeIntegrityEnabled": {
      "type": "boolean",
      "required": false
    },
    "activeFirewallRequired": {
      "type": "boolean",
      "required": false
    },
    "tpmRequired": {
      "type": "boolean",
      "required": false
    },
    "antivirusRequired": {
      "type": "boolean",
      "required": false
    },
    "antiSpywareRequired": {
      "type": "boolean",
      "required": false
    },
    "scheduledActionsForRule": {
      "type": "array",
      "required": true
    }
  }
}
