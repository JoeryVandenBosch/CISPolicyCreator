    "displayName": { "type": "string", "required": true, "minLength": 1 },
    "description": { "type": "string", "required": true, "minLength": 1 },
    "securityBlockJailbrokenDevices": { "type": "boolean", "required": false },
    "osMinimumVersion": { "type": "string", "required": false, "minLength": 1 },
    "osMinimumBuildVersion": { "type": "string", "required": false, "minLength": 1 },
    "scheduledActionsForRule": { "type": "array", "required": true }
