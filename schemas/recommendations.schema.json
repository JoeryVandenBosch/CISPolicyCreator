{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/recommendations.schema.json",
  "title": "CISPolicyCreator recommendation inventory",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["recommendationId", "profiles", "cisAssessmentMethod", "mappingStatus"],
    "properties": {
      "recommendationId": { "type": "string", "minLength": 1 },
      "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
      "cisAssessmentMethod": { "enum": ["Manual", "Automated"] },
      "mappingStatus": { "enum": ["mapped", "unresolved", "requires-input", "manual", "not-applicable"] },
      "catalogMappingStatus": { "enum": ["mapped", "unresolved", "requires-input", "manual", "not-applicable"] },
      "decisionRef": { "type": ["string", "null"] },
      "decisionRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
      "implementationType": { "type": ["string", "null"] },
      "implementationRefs": { "type": "array", "items": { "type": "string" } },
      "notes": { "type": ["string", "null"] }
    },
    "additionalProperties": false
  }
}
