{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/mapping-catalog.schema.json",
  "title": "CISPolicyCreator reviewed benchmark mapping catalog",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "benchmark", "pack", "sourceDocument", "recommendations", "administratorInputs", "settingsCatalogPolicies", "settingsCatalogSettings", "graphObjects"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "benchmark": {
      "type": "object",
      "required": ["id", "version", "expectedRecommendationCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "expectedRecommendationCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sourceDocument": {
      "type": "object",
      "required": ["requiredText"],
      "properties": {
        "requiredText": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["recommendationId", "profiles", "cisAssessmentMethod", "mappingStatus", "implementationRefs"],
        "properties": {
          "recommendationId": { "type": "string", "minLength": 1 },
          "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "cisAssessmentMethod": { "enum": ["Manual", "Automated"] },
          "mappingStatus": { "enum": ["mapped", "unresolved", "requires-input", "manual", "not-applicable"] },
          "implementationType": { "type": ["string", "null"] },
          "implementationRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "decisionRef": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "administratorInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "recommendationId", "prompt", "valueType"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "recommendationId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "valueType": { "enum": ["choice", "integer", "string", "boolean"] },
          "allowedValues": { "type": "array", "minItems": 1, "uniqueItems": true },
          "minimum": { "type": "integer" },
          "maximum": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "settingsCatalogPolicies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "platforms", "technologies", "profiles"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "platforms": { "type": "string", "minLength": 1 },
          "technologies": { "type": "string", "minLength": 1 },
          "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "roleScopeTagIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "settingsCatalogSettings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendationId", "policyId", "displayName", "profiles", "resolve", "value"],
        "properties": {
          "recommendationId": { "type": "string", "minLength": 1 },
          "policyId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "resolve": {
            "type": "object",
            "properties": {
              "definitionId": { "type": ["string", "null"] },
              "baseUri": { "type": ["string", "null"] },
              "offsetUri": { "type": ["string", "null"] },
              "expectedType": { "type": "string", "minLength": 1 }
            },
            "required": ["definitionId", "baseUri", "offsetUri", "expectedType"],
            "additionalProperties": false
          },
          "value": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["choice", "integer", "string"] },
              "optionId": { "type": ["string", "null"] },
              "value": {},
              "decisionRef": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "graphObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "recommendationIds", "profiles", "endpoint", "payload"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "recommendationIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "endpoint": { "type": "string", "minLength": 1 },
          "listEndpoint": { "type": ["string", "null"] },
          "nameProperty": { "type": ["string", "null"] },
          "payload": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
