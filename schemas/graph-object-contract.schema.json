{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/graph-object-contract.schema.json",
  "title": "CISPolicyCreator pinned Microsoft Graph object contract",
  "type": "object",
  "required": ["schemaVersion", "id", "sourceUrl", "lastReviewed", "endpoint", "listEndpoint", "itemEndpointTemplate", "nameProperty", "odataType", "properties"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://learn\\.microsoft\\.com/" },
    "lastReviewed": { "type": "string", "format": "date" },
    "endpoint": { "type": "string", "pattern": "^https://graph\\.microsoft\\.com/(beta|v1\\.0)/deviceManagement/" },
    "listEndpoint": { "type": "string", "pattern": "^https://graph\\.microsoft\\.com/(beta|v1\\.0)/deviceManagement/" },
    "itemEndpointTemplate": { "type": "string", "pattern": "^https://graph\\.microsoft\\.com/(beta|v1\\.0)/deviceManagement/.+\\{id\\}$" },
    "nameProperty": { "type": "string", "minLength": 1 },
    "odataType": { "type": "string", "pattern": "^#microsoft\\.graph\\." },
    "properties": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "required"],
        "properties": {
          "type": { "enum": ["boolean", "integer", "string"] },
          "required": { "type": "boolean" },
          "const": {},
          "enum": { "type": "array", "minItems": 1, "uniqueItems": true },
          "minimum": { "type": "integer" },
          "maximum": { "type": "integer" },
          "minLength": { "type": "integer", "minimum": 0 },
          "maxLength": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
