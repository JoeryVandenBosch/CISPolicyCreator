{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/manifest.schema.json",
  "title": "CISPolicyCreator pack manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "benchmarkScope", "sourceDocumentIncluded", "source", "build", "recommendationsSpec", "settingsCatalogPolicyDirectory", "settingsCatalogSpec", "graphObjects", "settingsCatalogProbe"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "benchmarkScope": { "type": "string", "const": "microsoft-intune" },
    "sourceDocumentIncluded": { "type": "boolean", "const": false },
    "source": {
      "type": "object",
      "required": ["fileName", "sha256", "pageCount"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pageCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": ["toolVersion", "extractorVersion", "pdfParser", "pdfParserVersion", "mappingCatalogId", "mappingCatalogVersion", "mappingCatalogSha256"],
      "properties": {
        "toolVersion": { "type": "string", "minLength": 1 },
        "extractorVersion": { "type": "string", "minLength": 1 },
        "pdfParser": { "const": "pypdf" },
        "pdfParserVersion": { "type": "string", "minLength": 1 },
        "mappingCatalogId": { "type": "string", "minLength": 1 },
        "mappingCatalogVersion": { "type": "string", "minLength": 1 },
        "mappingCatalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "administratorDecisionsSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "settingsCatalogSnapshotSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "recommendationsSpec": { "type": "string", "minLength": 1 },
    "settingsCatalogPolicyDirectory": { "type": "string" },
    "settingsCatalogSpec": { "type": "string" },
    "graphObjects": { "type": "string" },
    "settingsCatalogProbe": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
