{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/manifest.schema.json",
  "title": "CISPolicyCreator pack manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "benchmarkScope", "recommendationsSpec"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "benchmarkScope": { "type": "string", "const": "microsoft-intune" },
    "sourceDocumentIncluded": { "type": "boolean", "const": false },
    "recommendationsSpec": { "type": "string", "minLength": 1 },
    "settingsCatalogPolicyDirectory": { "type": "string" },
    "settingsCatalogSpec": { "type": "string" },
    "graphObjects": { "type": "string" },
    "settingsCatalogProbe": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
