{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/settings-catalog.schema.json",
  "title": "CISPolicyCreator dynamic Settings Catalog specification",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["recommendationId", "mappingStatus", "policy", "displayName", "profiles", "resolve", "value"],
    "properties": {
      "recommendationId": { "type": "string", "minLength": 1 },
      "mappingStatus": { "type": "string", "const": "mapped" },
      "policy": { "type": "string", "minLength": 1 },
      "displayName": { "type": "string", "minLength": 1 },
      "profiles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "resolve": {
        "type": "object",
        "minProperties": 1,
        "required": ["definitionId", "baseUri", "offsetUri", "expectedType"],
        "properties": {
          "definitionId": { "type": ["string", "null"] },
          "baseUri": { "type": ["string", "null"] },
          "offsetUri": { "type": ["string", "null"] },
          "expectedType": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "value": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["choice", "integer", "string"] },
          "optionId": { "type": ["string", "null"] },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
