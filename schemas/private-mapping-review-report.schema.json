{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/private-mapping-review-report.schema.json",
  "title": "CISPolicyCreator private mapping review progress report",
  "type": "object",
  "required": ["schemaVersion", "tool", "mappingChangesMade", "benchmark", "source", "summary", "recommendations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "Get-CISMappingReviewReport.ps1" },
        "version": { "const": "0.1.0" }
      },
      "additionalProperties": false
    },
    "mappingChangesMade": { "const": false },
    "benchmark": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["catalogSha256", "reviewWorklistSha256", "approvalsSha256", "settingsCatalogSnapshotSha256"],
      "properties": {
        "catalogSha256": { "$ref": "#/$defs/sha256" },
        "reviewWorklistSha256": { "$ref": "#/$defs/sha256" },
        "approvalsSha256": { "$ref": "#/$defs/sha256" },
        "settingsCatalogSnapshotSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["recommendationCount", "catalogMapped", "catalogUnresolved", "catalogRequiresInput", "catalogManual", "catalogNotApplicable", "uniqueCandidates", "ambiguousCandidates", "noCandidates", "reviewRows", "deferredReviews", "rejectedReviews", "mappedReviews", "reviewedRows", "pendingReviewRows", "selectionCount", "reviewQueueComplete", "catalogComplete", "readyForCatalogPromotion"],
      "properties": {
        "recommendationCount": { "type": "integer", "minimum": 1 },
        "catalogMapped": { "type": "integer", "minimum": 0 },
        "catalogUnresolved": { "type": "integer", "minimum": 0 },
        "catalogRequiresInput": { "type": "integer", "minimum": 0 },
        "catalogManual": { "type": "integer", "minimum": 0 },
        "catalogNotApplicable": { "type": "integer", "minimum": 0 },
        "uniqueCandidates": { "type": "integer", "minimum": 0 },
        "ambiguousCandidates": { "type": "integer", "minimum": 0 },
        "noCandidates": { "type": "integer", "minimum": 0 },
        "reviewRows": { "type": "integer", "minimum": 0 },
        "deferredReviews": { "type": "integer", "minimum": 0 },
        "rejectedReviews": { "type": "integer", "minimum": 0 },
        "mappedReviews": { "type": "integer", "minimum": 0 },
        "reviewedRows": { "type": "integer", "minimum": 0 },
        "pendingReviewRows": { "type": "integer", "minimum": 0 },
        "selectionCount": { "type": "integer", "minimum": 0 },
        "reviewQueueComplete": { "type": "boolean" },
        "catalogComplete": { "type": "boolean" },
        "readyForCatalogPromotion": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["recommendationId", "profiles", "cisAssessmentMethod", "catalogMappingStatus", "candidateStatus", "candidateCount", "occurrenceCount", "reviewOutcome", "acknowledged", "selectionCount", "state"],
        "properties": {
          "recommendationId": { "type": "string", "minLength": 1 },
          "profiles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "cisAssessmentMethod": { "enum": ["Manual", "Automated"] },
          "catalogMappingStatus": { "enum": ["mapped", "unresolved", "requires-input", "manual", "not-applicable"] },
          "candidateStatus": { "enum": ["none", "unique-candidate", "ambiguous-candidates"] },
          "candidateCount": { "type": "integer", "minimum": 0 },
          "occurrenceCount": { "type": "integer", "minimum": 0 },
          "reviewOutcome": { "enum": [null, "defer", "rejected", "mapped"] },
          "acknowledged": { "type": "boolean" },
          "selectionCount": { "type": "integer", "minimum": 0 },
          "state": { "enum": ["catalog-resolved", "no-candidate", "pending-review", "candidate-rejected", "candidate-approved"] }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
