{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/mapping-review-approvals.schema.json",
  "title": "CISPolicyCreator private mapping review approvals",
  "type": "object",
  "required": ["schemaVersion", "catalog", "reviewWorklist", "output", "reviews"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "catalog": {
      "type": "object",
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "reviewWorklist": {
      "type": "object",
      "required": ["sha256", "settingsCatalogSnapshotSha256"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "settingsCatalogSnapshotSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["catalogVersion", "packVersion"],
      "properties": {
        "catalogVersion": { "type": "string", "minLength": 1 },
        "packVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendationId", "candidateStatus", "outcome", "acknowledged", "valueBasis", "reviewedBy", "justification", "publicNotes", "selections"],
        "properties": {
          "recommendationId": { "type": "string", "minLength": 1 },
          "candidateStatus": { "enum": ["unique-candidate", "ambiguous-candidates"] },
          "outcome": { "enum": ["defer", "rejected", "mapped"] },
          "acknowledged": { "type": "boolean" },
          "valueBasis": { "enum": [null, "benchmark-prescribed"] },
          "reviewedBy": { "type": ["string", "null"], "minLength": 1 },
          "justification": { "type": ["string", "null"], "minLength": 1 },
          "publicNotes": { "type": ["string", "null"], "minLength": 1 },
          "selections": {
            "type": "array",
            "items": { "$ref": "#/$defs/selection" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "outcome": { "const": "defer" } }, "required": ["outcome"] },
            "then": {
              "properties": {
                "acknowledged": { "const": false },
                "valueBasis": { "const": null },
                "reviewedBy": { "const": null },
                "justification": { "const": null },
                "publicNotes": { "const": null },
                "selections": { "maxItems": 0 }
              }
            }
          },
          {
            "if": { "properties": { "outcome": { "const": "rejected" } }, "required": ["outcome"] },
            "then": {
              "properties": {
                "acknowledged": { "const": true },
                "valueBasis": { "const": null },
                "reviewedBy": { "type": "string", "minLength": 1 },
                "justification": { "type": "string", "minLength": 1 },
                "publicNotes": { "type": "string", "minLength": 1 },
                "selections": { "maxItems": 0 }
              }
            }
          },
          {
            "if": { "properties": { "outcome": { "const": "mapped" } }, "required": ["outcome"] },
            "then": {
              "properties": {
                "acknowledged": { "const": true },
                "valueBasis": { "const": "benchmark-prescribed" },
                "reviewedBy": { "type": "string", "minLength": 1 },
                "justification": { "type": "string", "minLength": 1 },
                "publicNotes": { "type": "string", "minLength": 1 },
                "selections": { "minItems": 1 }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selection": {
      "type": "object",
      "required": ["candidateDefinitionId", "sourceFile", "path", "topLevelDefinitionId", "policy"],
      "properties": {
        "candidateDefinitionId": { "type": "string", "minLength": 1 },
        "sourceFile": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^settings\\[[1-9][0-9]*\\](?:/.*)?$" },
        "topLevelDefinitionId": { "type": "string", "minLength": 1 },
        "policy": { "$ref": "#/$defs/policy" }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["id", "name", "description", "platforms", "technologies", "profiles", "roleScopeTagIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "platforms": { "type": "string", "minLength": 1 },
        "technologies": { "type": "string", "minLength": 1 },
        "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "roleScopeTagIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
