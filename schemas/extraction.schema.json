{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/extraction.schema.json",
  "title": "CISPolicyCreator private PDF extraction",
  "type": "object",
  "required": ["schemaVersion", "tool", "benchmark", "source", "recommendations"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "tool": {
      "type": "object",
      "required": ["extractorVersion", "pdfParser", "pdfParserVersion"],
      "properties": {
        "extractorVersion": { "const": "0.3.0" },
        "pdfParser": { "const": "pypdf" },
        "pdfParserVersion": { "const": "6.15.0" }
      },
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "required": ["id", "version", "requiredTextMatched"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "requiredTextMatched": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["fileName", "sha256", "pageCount"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pageCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["recommendationId", "title", "page", "profiles", "cisAssessmentMethod", "profileApplicability"],
        "properties": {
          "recommendationId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "page": { "type": "integer", "minimum": 1 },
          "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "cisAssessmentMethod": { "enum": ["Manual", "Automated"] },
          "profileApplicability": { "type": "string", "minLength": 1 },
          "audit": { "type": ["string", "null"] },
          "remediation": { "type": ["string", "null"] },
          "defaultValue": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
