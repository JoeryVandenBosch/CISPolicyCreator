{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/graph-objects.schema.json",
  "title": "CISPolicyCreator generic Intune Graph objects",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "mappingStatus", "recommendationIds", "profiles", "contractId", "contractSha256", "endpoint", "payload"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "mappingStatus": { "type": "string", "const": "mapped" },
      "recommendationIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "profiles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "contractId": { "type": "string", "minLength": 1 },
      "contractSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "endpoint": { "type": "string", "pattern": "^https://graph\\.microsoft\\.com/(beta|v1\\.0)/deviceManagement/" },
      "listEndpoint": { "type": ["string", "null"], "pattern": "^https://graph\\.microsoft\\.com/(beta|v1\\.0)/deviceManagement/" },
      "nameProperty": { "type": ["string", "null"] },
      "payload": { "type": "object" }
    },
    "additionalProperties": false
  }
}
