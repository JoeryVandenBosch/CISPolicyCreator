{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cispolicycreator.local/schema/portable-policy-bundle.schema.json",
  "title": "CISPolicyCreator portable Intune JSON bundle manifest",
  "type": "object",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recommendationIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "settingsCatalogFile": {
      "type": "object",
      "required": ["path", "name", "platforms", "technologies", "recommendationIds", "settingCount", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^SettingsCatalog/[A-Za-z0-9._-]+\\.json$" },
        "name": { "type": "string", "minLength": 1 },
        "platforms": { "type": "string", "minLength": 1 },
        "technologies": { "type": "string", "minLength": 1 },
        "recommendationIds": { "$ref": "#/$defs/recommendationIds" },
        "settingCount": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "graphObjectFile": {
      "type": "object",
      "required": ["path", "name", "endpoint", "listEndpoint", "nameProperty", "contractId", "contractSha256", "recommendationIds", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(DeviceConfigurations|CompliancePolicies|GraphObjects)/[A-Za-z0-9._-]+\\.json$" },
        "name": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "pattern": "^https://graph\\.microsoft\\.com/(beta|v1\\.0)/deviceManagement/" },
        "listEndpoint": { "type": "string", "pattern": "^https://graph\\.microsoft\\.com/(beta|v1\\.0)/deviceManagement/" },
        "nameProperty": { "type": "string", "minLength": 1 },
        "contractId": { "type": "string", "minLength": 1 },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "recommendationIds": { "$ref": "#/$defs/recommendationIds" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "bundleType", "pack", "profile", "source", "build", "assignmentsIncluded", "tenantMetadataIncluded", "files", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "bundleType": { "const": "cispolicycreator-portable-intune-json" },
    "pack": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "profile": { "enum": ["L1", "L2", "BL", "L1BL", "ALL"] },
    "source": {
      "type": "object",
      "required": ["fileName", "sha256", "pageCount", "documentIncluded"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "documentIncluded": { "const": false }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": ["packManifestSha256", "settingsCatalogSnapshotSha256"],
      "properties": {
        "packManifestSha256": { "$ref": "#/$defs/sha256" },
        "settingsCatalogSnapshotSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "assignmentsIncluded": { "const": false },
    "tenantMetadataIncluded": { "const": false },
    "files": {
      "type": "object",
      "required": ["mappingReport", "settingsCatalog", "graphObjects"],
      "properties": {
        "mappingReport": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": { "const": "mapping-report.json" },
            "sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "settingsCatalog": {
          "type": "array",
          "items": { "$ref": "#/$defs/settingsCatalogFile" }
        },
        "graphObjects": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphObjectFile" }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["recommendationCount", "mapped", "unresolved", "requiresInput", "manual", "notApplicable", "settingsCatalogPolicyCount", "settingsCatalogSettingCount", "graphObjectCount", "partial"],
      "properties": {
        "recommendationCount": { "type": "integer", "minimum": 0 },
        "mapped": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 },
        "requiresInput": { "type": "integer", "minimum": 0 },
        "manual": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 },
        "settingsCatalogPolicyCount": { "type": "integer", "minimum": 0 },
        "settingsCatalogSettingCount": { "type": "integer", "minimum": 0 },
        "graphObjectCount": { "type": "integer", "minimum": 0 },
        "partial": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
